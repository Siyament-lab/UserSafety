@page
@model UserSafetyWeb.Pages.LoginModel
@{
    ViewData["Title"] = "Logga in";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="text-center mb-4">Logga in</h2>

            @if (!string.IsNullOrEmpty (Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }
            @if (!string.IsNullOrEmpty (Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Användarnamn</label>
                    <input asp-for="Username" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Lösenord</label>
                    <input asp-for="Password" type="password" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Logga in</button>
                <div class="text-center mt-3">
                    <a href="/Register">Inget konto? Registrera dig här</a>
                </div>
            </form>
        </div>
    </div>
</div>